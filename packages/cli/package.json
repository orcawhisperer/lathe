{
  "name": "@orcawhisperer/lathe-cli",
  "version": "0.1.0",
  "description": "Command-line compiler, catalog linter, guard verifier, and HTML renderer for Lathe (A2UI v0.9 + AG-UI + TypeSafe System One)",
  "type": "module",
  "bin": {
    "lathe": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@orcawhisperer/lathe-core": "workspace:*",
    "@orcawhisperer/lathe-shadcn": "workspace:*",
    "@orcawhisperer/lathe-guard": "workspace:*",
    "@orcawhisperer/lathe-ag-ui": "workspace:*",
    "@orcawhisperer/lathe-react": "workspace:*",
    "@orcawhisperer/lathe-typesafe": "workspace:*",
    "@orcawhisperer/lathe-mcp": "workspace:*"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orcawhisperer/lathe.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/orcawhisperer/lathe#readme",
  "bugs": {
    "url": "https://github.com/orcawhisperer/lathe/issues"
  }
}
