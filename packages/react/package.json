{
  "name": "@orcawhisperer/lathe-react",
  "version": "0.1.1",
  "description": "A2UI v0.9 surface renderer with shadcn/ui styling, confidence-driven runner-up swap pills, and two-way RFC 6901 JSON Pointer state patching.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@orcawhisperer/lathe-core": "workspace:*",
    "@orcawhisperer/lathe-guard": "workspace:*",
    "@orcawhisperer/lathe-ag-ui": "workspace:*"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orcawhisperer/lathe.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/orcawhisperer/lathe#readme",
  "bugs": {
    "url": "https://github.com/orcawhisperer/lathe/issues"
  }
}
